# Copy to .env.local and fill in. Never commit .env.local (it's git-ignored).

# --- Firebase web app config (Firebase Console → Project settings → Your apps) ---
# These identify the project; they are not secrets. Security comes from Auth + security rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=knowledgeable-jei7k.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=knowledgeable-jei7k
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=knowledgeable-jei7k.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---
# Service account JSON on ONE line, only needed when running the server locally against the real
# project. On Firebase App Hosting leave it unset — the runtime's own identity is used.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Gemini API key for the AI helpers (summaries, questions, explanations).
GEMINI_API_KEY=
# Optional: Gemini model id (Google retires old ones; gemini-2.0-flash is gone).
# GEMINI_MODEL=gemini-3.8-flash

# --- Notifications (see README → Notifications) ---
# Public Web Push key: Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# The site's public address (e.g. https://your-domain.com), used in links inside emails.
APP_URL=
# Random string (32+ characters) that Cloud Scheduler sends to /api/cron/morning. Keep it secret.
CRON_SECRET=
# Optional: an email for OpenAlex's "polite pool" (faster academic-paper search).
# OPENALEX_EMAIL=

# --- Local development with the Firebase Emulator Suite (npm run emulators) ---
# Uncomment everything below to develop fully offline with fake users and data.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=127.0.0.1
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-knowledgeable
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-knowledgeable.appspot.com
# NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
