rules_version = '2';

// Knowledgeable — Cloud Storage rules. Deny by default; users may only upload into their own
// folders, only specific file types, and only up to a size limit.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isImage(maxMb) {
      return request.resource.contentType.matches('image/(png|jpeg|webp|gif)')
        && request.resource.size < maxMb * 1024 * 1024;
    }
    function isVideo(maxMb) {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)')
        && request.resource.size < maxMb * 1024 * 1024;
    }
    function isDocument(maxMb) {
      return request.resource.contentType in ['application/pdf', 'text/plain', 'application/epub+zip']
        && request.resource.size < maxMb * 1024 * 1024;
    }

    // Profile pictures.
    match /users/{uid}/avatar/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isImage(5);
      allow delete: if isOwner(uid);
    }

    // Media attached to posts: images, short videos (reels) and research documents.
    match /posts/{uid}/{postId}/{fileName} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && verified() && (isImage(10) || isVideo(100) || isDocument(25));
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // Files shared in a chat. Conversation ids are "<smallerUid>_<largerUid>" (enforced by
    // firestore.rules), so membership can be read from the id itself. Only the two people in the
    // conversation can read; only the sender can upload, and not if either has blocked the other.
    function chatFile(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024 && request.resource.contentType in [
        'image/png', 'image/jpeg', 'image/webp', 'image/gif',
        'application/pdf', 'text/plain', 'text/csv', 'application/epub+zip',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
      ];
    }
    function inConversation(convoId) {
      return signedIn() && request.auth.uid in convoId.split('_');
    }
    function blockedEitherWay(convoId) {
      let parts = convoId.split('_');
      let other = parts[0] == request.auth.uid ? parts[1] : parts[0];
      return firestore.exists(/databases/(default)/documents/users/$(other)/blocked/$(request.auth.uid))
        || firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/blocked/$(other));
    }
    match /chats/{convoId}/{senderUid}/{fileName} {
      allow read: if inConversation(convoId);
      allow create: if isOwner(senderUid) && verified() && inConversation(convoId)
        && convoId.split('_').size() == 2
        && chatFile(25)
        && !blockedEitherWay(convoId);
      allow update: if false;
      allow delete: if isOwner(senderUid);
    }

    // Evidence attached to a report. Write-only for the reporter; only admins can read it.
    match /reports/{uid}/{reportId}/{fileName} {
      allow read: if signedIn() && request.auth.token.get('admin', false) == true;
      allow create: if isOwner(uid)
        && (isImage(5) || (request.resource.contentType == 'application/pdf' && request.resource.size < 5 * 1024 * 1024));
      allow update, delete: if false;
    }

    // The library's own copies of books, papers and articles are written by the server only.
    match /library/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
