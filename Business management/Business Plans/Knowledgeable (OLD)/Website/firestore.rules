rules_version = '2';

// Knowledgeable — Firestore security rules.
//
// These rules are the real security boundary: the browser talks to Firestore directly, so
// every read and write below is checked by Google's servers regardless of what the client code
// does. Principles:
//   • Deny by default — anything not matched here is rejected.
//   • Users can only write their own data; author fields must match the signed-in user.
//   • Every field is type- and size-checked so nobody can store junk or huge blobs.
//   • Counters (likes, poll votes) can only move by exactly ±1 in the same batch as the
//     like/vote document, so they can't be inflated.
//   • Personal details live in users/{uid}/private and are readable only by their owner.
//   • Tests: rules-tests/firestore.rules.test.ts (npm run test:rules).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    // Email/password users must verify their address before they can publish anything.
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return incoming().diff(existing()).affectedKeys(); }

    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(data, key, max) { return !(key in data) || isStr(data[key], 0, max); }
    function isProgress(v) { return (v is float || v is int) && v >= 0 && v <= 1; }
    function isStorageUrl(v) {
      return v is string && v.size() <= 2048 && (
        v.matches('^https://firebasestorage[.]googleapis[.]com/.*') ||
        v.matches('^http://127[.]0[.]0[.]1:9199/.*'));
    }
    // Paths must be built segment by segment: $(a + '/' + b) would be ONE segment named "a/b".
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function postPath(postId) { return /databases/$(database)/documents/posts/$(postId); }
    function profileOf(uid) { return get(userPath(uid)).data; }
    // True when `blocker` has blocked `other`. Blocking stops messages, comments and follows.
    function hasBlocked(blocker, other) {
      return exists(/databases/$(database)/documents/users/$(blocker)/blocked/$(other));
    }
    function eitherBlocked(a, b) { return hasBlocked(a, b) || hasBlocked(b, a); }

    // Keep in sync with src/lib/taxonomy.ts (a unit test enforces this).
    function topicIds() {
      return [
        'history', 'biology', 'genetics', 'marine-biology', 'botany', 'zoology', 'ecology',
        'gastronomy', 'baking', 'world-cuisines', 'food-science', 'mixology', 'physics',
        'astrophysics', 'quantum-mechanics', 'natural-forces', 'cosmology', 'thermodynamics',
        'electricity', 'chemistry', 'organic-chemistry', 'biochemistry', 'physical-chemistry',
        'mathematics', 'calculus', 'statistics', 'algebra', 'geometry', 'number-theory', 'languages',
        'spanish', 'japanese', 'french', 'german', 'linguistics', 'business', 'management',
        'finance-accounting', 'marketing', 'entrepreneurship', 'economics', 'self-development',
        'productivity', 'habits', 'communication', 'leadership', 'learning-how-to-learn', 'politics',
        'philosophy', 'ethics', 'stoicism', 'logic', 'philosophy-of-science', 'technology', 'ai',
        'software-dev', 'cybersecurity', 'data-science', 'web-development', 'arts-culture', 'music',
        'visual-arts', 'literature', 'film-studies', 'theater', 'education', 'psychology', 'science',
        'geography', 'cartography', 'human-geography', 'physical-geography', 'environmental-science',
        'climate-change', 'conservation', 'engineering', 'mechanical-eng', 'civil-eng',
        'electrical-eng', 'aerospace-eng', 'medicine', 'anatomy', 'pharmacology', 'neurology', 'law',
        'sociology', 'anthropology', 'archaeology', 'music-theory', 'graphic-design',
        'creative-writing', 'astronomy', 'mythology', 'robotics', 'nutrition', 'sports-science',
        'architecture', 'fashion-design', 'journalism', 'cryptography', 'game-development',
        'urban-planning'
      ];
    }
    function isTopicList(v, min, max) {
      return v is list && v.size() >= min && v.size() <= max && v.hasOnly(topicIds());
    }

    // ---------- users (public profile) ----------
    function validProfile(d) {
      return d.keys().hasAll(['displayName', 'nameLower', 'handle', 'interests', 'readingPublic', 'createdAt'])
        && d.keys().hasOnly(['displayName', 'nameLower', 'handle', 'avatarUrl', 'bio', 'interests', 'readingPublic', 'createdAt'])
        && isStr(d.displayName, 1, 60)
        && d.nameLower == d.displayName.lower()
        && d.handle is string && d.handle.matches('^[a-z0-9_]{3,20}$')
        && optStr(d, 'bio', 280)
        && (!('avatarUrl' in d) || isStorageUrl(d.avatarUrl) || d.avatarUrl.matches('^https://lh3[.]googleusercontent[.]com/.*'))
        && isTopicList(d.interests, 0, 60)
        && d.readingPublic is bool
        && d.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && validProfile(incoming())
        && incoming().createdAt == request.time
        // The handle must be reserved for this user in the same batch.
        && getAfter(/databases/$(database)/documents/handles/$(incoming().handle)).data.uid == uid;
      allow update: if isUser(uid)
        && validProfile(incoming())
        && incoming().handle == existing().handle
        && incoming().createdAt == existing().createdAt;
      allow delete: if false; // account deletion runs server-side (api/account)

      // Owner-only personal details.
      match /private/{docId} {
        allow read: if isUser(uid);
        // Notification settings (read by the server to decide what to send).
        allow write: if isUser(uid) && docId == 'notifications'
          && incoming().keys().hasOnly(['morning', 'morningHour', 'activity', 'email', 'timezone', 'locale'])
          && incoming().morning is bool && incoming().activity is bool && incoming().email is bool
          && incoming().morningHour is int && incoming().morningHour >= 0 && incoming().morningHour <= 23
          && isStr(incoming().timezone, 1, 64)
          && incoming().locale in ['en-GB', 'es', 'fr'];
        allow write: if isUser(uid) && docId == 'account'
          && incoming().keys().hasOnly(['nationality', 'country', 'spokenLanguages', 'birthYear'])
          && optStr(incoming(), 'nationality', 80)
          && optStr(incoming(), 'country', 80)
          && optStr(incoming(), 'spokenLanguages', 200)
          && (!('birthYear' in incoming()) || (incoming().birthYear is int
                && incoming().birthYear >= 1900 && incoming().birthYear <= 2030));
      }

      // Reading lists + reader progress. Visible to others only if the owner allows it.
      match /library/{bookId} {
        allow read: if isUser(uid) || (signedIn() && profileOf(uid).readingPublic == true);
        allow delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && exists(/databases/$(database)/documents/books/$(bookId))
          && incoming().bookId == bookId
          && incoming().keys().hasOnly(['bookId', 'status', 'progress', 'chapterIndex', 'chapterProgress',
               'finishedInApp', 'bookTitle', 'bookAuthor', 'bookCoverUrl', 'startedAt', 'finishedAt', 'updatedAt'])
          && incoming().status in ['want', 'reading', 'finished']
          && isProgress(incoming().progress)
          && incoming().chapterIndex is int && incoming().chapterIndex >= 0
          && isProgress(incoming().chapterProgress)
          && incoming().finishedInApp is bool
          && isStr(incoming().bookTitle, 1, 300)
          && isStr(incoming().bookAuthor, 0, 200)
          && optStr(incoming(), 'bookCoverUrl', 2048)
          && (!('startedAt' in incoming()) || incoming().startedAt is timestamp)
          && (!('finishedAt' in incoming()) || incoming().finishedAt is timestamp)
          && incoming().updatedAt == request.time;
      }

      // Saved posts ("stash") with spaced-repetition scheduling. Private.
      match /saved/{postId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && incoming().postId == postId
          && incoming().keys().hasOnly(['postId', 'postTitle', 'postType', 'savedAt', 'reviewStage', 'nextReviewAt'])
          && isStr(incoming().postTitle, 0, 200)
          && isStr(incoming().postType, 1, 20)
          && incoming().savedAt is timestamp
          && incoming().reviewStage is int && incoming().reviewStage >= 0 && incoming().reviewStage <= 10
          && incoming().nextReviewAt is timestamp;
      }

      // Follow graph: both edges are written together in one batch by the follower.
      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if isUser(uid) && targetUid != uid
          && exists(userPath(targetUid))
          && !eitherBlocked(uid, targetUid)
          && incoming().keys().hasOnly(['uid', 'createdAt'])
          && incoming().uid == targetUid && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(uid));
        // The follower can unfollow; the person followed can remove a follower (used when blocking).
        allow delete: if (isUser(uid) || isUser(targetUid))
          && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(uid));
      }
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if isUser(followerUid) && followerUid != uid
          && incoming().keys().hasOnly(['uid', 'createdAt'])
          && incoming().uid == followerUid && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(uid));
        allow delete: if (isUser(followerUid) || isUser(uid))
          && !existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(uid));
      }

      // People this user has blocked. Private to the owner (the blocked person isn't told).
      match /blocked/{targetUid} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid) && targetUid != uid
          && incoming().keys().hasOnly(['uid', 'createdAt'])
          && incoming().uid == targetUid && incoming().createdAt == request.time;
        allow update: if false;
      }

      // Highlights and notes made while reading. Private.
      match /annotations/{annotationId} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid)
          && incoming().keys().hasOnly(['bookId', 'bookTitle', 'chapterIndex', 'paragraphIndex', 'start', 'end',
               'quote', 'colour', 'note', 'createdAt', 'updatedAt'])
          && isStr(incoming().bookId, 1, 128)
          && isStr(incoming().bookTitle, 0, 300)
          && incoming().chapterIndex is int && incoming().chapterIndex >= 0
          && incoming().paragraphIndex is int && incoming().paragraphIndex >= 0
          && incoming().start is int && incoming().start >= 0
          && incoming().end is int && incoming().end > incoming().start
          && isStr(incoming().quote, 1, 1000)
          && incoming().colour in ['yellow', 'blue', 'green', 'pink']
          && optStr(incoming(), 'note', 2000)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isUser(uid)
          && changedKeys().hasOnly(['note', 'colour', 'updatedAt'])
          && optStr(incoming(), 'note', 2000)
          && incoming().colour in ['yellow', 'blue', 'green', 'pink']
          && incoming().updatedAt == request.time;
      }

      // "Save my place" markers. Private.
      match /bookmarks/{bookmarkId} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid)
          && incoming().keys().hasOnly(['bookId', 'bookTitle', 'chapterIndex', 'paragraphIndex', 'chapterTitle', 'snippet', 'createdAt'])
          && isStr(incoming().bookId, 1, 128)
          && bookmarkId == incoming().bookId + '_' + string(incoming().chapterIndex) + '_' + string(incoming().paragraphIndex)
          && isStr(incoming().bookTitle, 0, 300)
          && incoming().chapterIndex is int && incoming().chapterIndex >= 0
          && incoming().paragraphIndex is int && incoming().paragraphIndex >= 0
          && isStr(incoming().chapterTitle, 0, 200)
          && isStr(incoming().snippet, 0, 300)
          && incoming().createdAt == request.time;
        allow update: if false;
      }

      // Answers to the end-of-book reflection questions. Private.
      match /reflections/{bookId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && incoming().keys().hasOnly(['bookTitle', 'answers', 'updatedAt'])
          && isStr(incoming().bookTitle, 0, 300)
          && incoming().answers is list && incoming().answers.size() <= 10
          && incoming().updatedAt == request.time;
      }

      // In-app notifications are written only by the server; the owner reads, marks read and removes.
      match /notifications/{notificationId} {
        allow read, delete: if isUser(uid);
        allow update: if isUser(uid) && changedKeys().hasOnly(['read']) && incoming().read == true;
        allow create: if false;
      }

      // Devices registered for push notifications.
      match /devices/{deviceId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && deviceId.matches('^[a-f0-9]{40}$')
          && incoming().keys().hasOnly(['token', 'platform', 'userAgent', 'updatedAt'])
          && isStr(incoming().token, 1, 4096)
          && incoming().platform in ['installed', 'browser']
          && isStr(incoming().userAgent, 0, 200)
          && incoming().updatedAt == request.time;
      }
    }

    // ---------- handles (unique usernames) ----------
    match /handles/{handle} {
      allow read: if signedIn();
      // One handle per account, claimed together with the profile, never transferred.
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,20}$')
        && incoming().keys().hasOnly(['uid'])
        && incoming().uid == request.auth.uid
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.handle == handle;
      allow update, delete: if false;
    }

    // ---------- posts ----------
    function validNewPost(d) {
      let author = profileOf(request.auth.uid);
      return d.keys().hasAll(['authorId', 'authorName', 'authorHandle', 'type', 'title', 'body', 'topics', 'likeCount', 'createdAt'])
        && d.keys().hasOnly(['authorId', 'authorName', 'authorHandle', 'authorAvatarUrl', 'type', 'title', 'body',
             'topics', 'keywords', 'authors', 'source', 'poll', 'pollCounts', 'media', 'attachment', 'likeCount', 'createdAt'])
        && d.authorId == request.auth.uid
        && d.authorName == author.displayName
        && d.authorHandle == author.handle
        && d.get('authorAvatarUrl', null) == author.get('avatarUrl', null)
        && d.type in ['idea', 'summary', 'questions', 'opinion', 'article', 'research', 'poll', 'reel']
        && isStr(d.title, 1, 200)
        && isStr(d.body, 0, d.type == 'idea' ? 600 : 20000)
        && isTopicList(d.topics, 1, 3)
        && validKeywords(d)
        && d.likeCount == 0
        && d.createdAt == request.time
        && (!('authors' in d) || (d.authors is list && d.authors.size() <= 20))
        && (!('source' in d) || validSource(d.source))
        && (d.type == 'poll' ? validPoll(d) : !('poll' in d) && !('pollCounts' in d))
        && (!('media' in d) || validMedia(d.media))
        && (d.type != 'reel' || ('media' in d && 'videoUrl' in d.media))
        && (!('attachment' in d) || validAttachment(d.attachment));
    }
    // Lower-cased title words used for search (Firestore has no full-text search).
    function validKeywords(d) {
      return !('keywords' in d) || (d.keywords is list && d.keywords.size() <= 40);
    }
    function validSource(s) {
      return s is map && s.keys().hasOnly(['kind', 'id', 'title', 'url'])
        && s.kind in ['book', 'post', 'url']
        && isStr(s.title, 1, 300)
        && optStr(s, 'id', 128)
        && (!('url' in s) || (isStr(s.url, 1, 2048) && s.url.matches('^https://.*')));
    }
    function validPoll(d) {
      return d.poll is map && d.poll.keys().hasOnly(['question', 'options'])
        && isStr(d.poll.question, 1, 300)
        && d.poll.options is list && d.poll.options.size() >= 2 && d.poll.options.size() <= 5
        && d.get('pollCounts', {}) == {};
    }
    function validMedia(m) {
      return m is map && m.keys().hasOnly(['imageUrl', 'videoUrl'])
        && (!('imageUrl' in m) || isStorageUrl(m.imageUrl))
        && (!('videoUrl' in m) || isStorageUrl(m.videoUrl));
    }
    function validAttachment(a) {
      return a is map && a.keys().hasOnly(['path', 'name', 'contentType', 'size', 'url'])
        && isStr(a.path, 1, 512) && a.path.matches('^posts/' + request.auth.uid + '/.*')
        && isStr(a.name, 1, 200)
        && a.contentType in ['application/pdf', 'text/plain', 'application/epub+zip']
        && a.size is int && a.size > 0 && a.size <= 26214400
        && isStorageUrl(a.url);
    }

    function likeToggled(postId) {
      let likePath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      return changedKeys().hasOnly(['likeCount'])
        && ((incoming().likeCount == existing().likeCount + 1 && !exists(likePath) && existsAfter(likePath))
         || (incoming().likeCount == existing().likeCount - 1 && exists(likePath) && !existsAfter(likePath)));
    }
    function voteRecorded(postId) {
      let votePath = /databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid);
      return existing().type == 'poll'
        && changedKeys().hasOnly(['pollCounts'])
        && !exists(votePath) && existsAfter(votePath)
        && incoming().pollCounts.diff(existing().get('pollCounts', {})).affectedKeys()
             .hasOnly([string(getAfter(votePath).data.option)]);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if verified() && validNewPost(incoming());
      allow update: if signedIn() && (
        // Authors may edit the wording and topics of their own post.
        (isUser(existing().authorId) && verified()
          && changedKeys().hasOnly(['title', 'body', 'topics', 'keywords'])
          && validKeywords(incoming())
          && isStr(incoming().title, 1, 200)
          && isStr(incoming().body, 0, existing().type == 'idea' ? 600 : 20000)
          && isTopicList(incoming().topics, 1, 3))
        || likeToggled(postId)
        || voteRecorded(postId));
      allow delete: if isUser(existing().authorId);

      match /likes/{uid} {
        allow get: if isUser(uid);
        allow create: if isUser(uid)
          && incoming().keys().hasOnly(['uid', 'createdAt'])
          && incoming().uid == uid && incoming().createdAt == request.time
          && getAfter(postPath(postId)).data.likeCount == get(postPath(postId)).data.likeCount + 1;
        allow delete: if isUser(uid)
          && getAfter(postPath(postId)).data.likeCount == get(postPath(postId)).data.likeCount - 1;
      }

      // One immutable vote per user. Only the voter can see their own vote.
      match /votes/{uid} {
        allow get: if isUser(uid);
        allow create: if isUser(uid)
          && incoming().keys().hasOnly(['uid', 'option', 'createdAt'])
          && incoming().uid == uid
          && incoming().createdAt == request.time
          && incoming().option is int
          && get(postPath(postId)).data.type == 'poll'
          && incoming().option >= 0
          && incoming().option < get(postPath(postId)).data.poll.options.size()
          && getAfter(postPath(postId)).data.pollCounts[string(incoming().option)]
               == get(postPath(postId)).data.get('pollCounts', {}).get(string(incoming().option), 0) + 1;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if verified()
          && incoming().keys().hasOnly(['authorId', 'authorName', 'authorAvatarUrl', 'text', 'createdAt'])
          && incoming().authorId == request.auth.uid
          && incoming().authorName == profileOf(request.auth.uid).displayName
          && incoming().get('authorAvatarUrl', null) == profileOf(request.auth.uid).get('avatarUrl', null)
          && isStr(incoming().text, 1, 2000)
          && incoming().createdAt == request.time
          && !hasBlocked(get(postPath(postId)).data.authorId, request.auth.uid);
        // Comment authors and the post's author can remove a comment.
        allow delete: if signedIn() && (request.auth.uid == existing().authorId
          || request.auth.uid == get(postPath(postId)).data.authorId);
        allow update: if false;
      }
    }

    // ---------- catalog (books + readable chapters) ----------
    match /books/{bookId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /chapters/{chapterId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // ---------- reports (moderation) ----------
    // Anyone signed in can file a report; only admins can read them (the admin area comes later).
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && incoming().keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetUserId', 'context', 'reason',
             'details', 'evidence', 'evidenceFiles', 'status', 'createdAt'])
        && incoming().reporterId == request.auth.uid
        && incoming().targetType in ['user', 'post', 'comment', 'message']
        && isStr(incoming().targetId, 1, 128)
        && isStr(incoming().targetUserId, 1, 128)
        && incoming().targetUserId != request.auth.uid
        && optStr(incoming(), 'context', 200)
        && incoming().reason in ['spam', 'harassment', 'hate', 'misinformation', 'copyright', 'sexual', 'violence',
             'impersonation', 'self-harm', 'other']
        && isStr(incoming().details, 0, 2000)
        && isStr(incoming().evidence, 0, 4000)
        && incoming().evidenceFiles is list && incoming().evidenceFiles.size() <= 3
        && incoming().status == 'open'
        && incoming().createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- direct messages ----------
    // Conversation ids are "<smallerUid>_<largerUid>" so each pair has exactly one thread.
    match /conversations/{convoId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in existing().participantIds);
      allow list: if signedIn() && request.auth.uid in existing().participantIds;
      allow create: if verified()
        && incoming().keys().hasOnly(['participantIds', 'updatedAt'])
        && incoming().participantIds is list && incoming().participantIds.size() == 2
        && request.auth.uid in incoming().participantIds
        && incoming().participantIds[0] < incoming().participantIds[1]
        && convoId == incoming().participantIds[0] + '_' + incoming().participantIds[1]
        && exists(userPath(incoming().participantIds[0]))
        && exists(userPath(incoming().participantIds[1]))
        && !eitherBlocked(incoming().participantIds[0], incoming().participantIds[1])
        && incoming().updatedAt == request.time;
      allow update: if verified() && request.auth.uid in existing().participantIds
        && changedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && incoming().lastMessage.keys().hasOnly(['text', 'senderId', 'createdAt'])
        && incoming().lastMessage.senderId == request.auth.uid
        && isStr(incoming().lastMessage.text, 1, 200)
        && incoming().lastMessage.createdAt == request.time
        && incoming().updatedAt == request.time;
      allow delete: if false;

      function otherParticipant(participants) {
        return participants[0] == request.auth.uid ? participants[1] : participants[0];
      }
      // A file shared in the chat; it lives in chats/{convoId}/{senderUid}/ in Cloud Storage.
      function validChatAttachment(a) {
        return a is map && a.keys().hasOnly(['path', 'name', 'contentType', 'size'])
          && isStr(a.path, 1, 512) && a.path.matches('^chats/' + convoId + '/' + request.auth.uid + '/[^/]+$')
          && isStr(a.name, 1, 200)
          && isStr(a.contentType, 1, 120)
          && a.size is int && a.size > 0 && a.size <= 26214400;
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participantIds;
        allow create: if verified()
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(convoId)).data.participantIds
          && !eitherBlocked(request.auth.uid,
               otherParticipant(get(/databases/$(database)/documents/conversations/$(convoId)).data.participantIds))
          && incoming().keys().hasOnly(['senderId', 'text', 'attachment', 'createdAt'])
          && incoming().senderId == request.auth.uid
          && ('attachment' in incoming()
                ? validChatAttachment(incoming().attachment) && isStr(incoming().text, 0, 2000)
                : isStr(incoming().text, 1, 2000))
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
